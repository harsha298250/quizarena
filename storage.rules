rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Default-deny all storage operations
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonAnonymous() {
      return isSignedIn() &&
        (!('firebase' in request.auth.token) ||
         request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|webp|gif)')
        && request.resource.size < 10 * 1024 * 1024;
    }

    function isValidPdf() {
      return request.resource.contentType == 'application/pdf'
        && request.resource.size < 15 * 1024 * 1024;
    }

    function isQuizAuthor(quizId) {
      return isNonAnonymous() &&
        firestore.exists(/databases/(default)/documents/quizzes/$(quizId)) &&
        firestore.get(/databases/(default)/documents/quizzes/$(quizId)).data.authorId == request.auth.uid;
    }

    function isTournamentHost(tournamentId) {
      return isNonAnonymous() &&
        firestore.exists(/databases/(default)/documents/tournaments/$(tournamentId)) &&
        firestore.get(/databases/(default)/documents/tournaments/$(tournamentId)).data.hostId == request.auth.uid;
    }

    // 1. User profile avatars (max 5MB, owner only, valid image format)
    match /avatars/{userId}/{fileName} {
      allow read: if true;
      allow write: if isOwner(userId) && isValidImage() && request.resource.size < 5 * 1024 * 1024;
    }

    // 2. Quiz illustration assets (max 10MB, quiz author only, valid image format)
    // Deletion allowed only for the author who owns the quiz document
    match /quizzes/{quizId}/{fileName} {
      allow read: if true;
      allow write: if isQuizAuthor(quizId) && isValidImage();
      allow delete: if isQuizAuthor(quizId);
    }

    // 3. Digital Certificate documents
    // Public read for verification; write and delete are strictly server-authoritative via Admin SDK
    match /certificates/{certificateId}/{fileName} {
      allow read: if true;
      allow write, delete: if false; // Server Admin SDK only
    }

    // 4. Tournament media & banners (max 10MB, tournament host only, valid image format)
    // Deletion allowed only for the tournament host
    match /tournaments/{tournamentId}/{fileName} {
      allow read: if true;
      allow write: if isTournamentHost(tournamentId) && isValidImage();
      allow delete: if isTournamentHost(tournamentId);
    }
  }
}

