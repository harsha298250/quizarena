rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Anonymous players MUST NOT count for administrative/teacher/host collections
    function isNonAnonymous() {
      return isSignedIn() &&
        (!('firebase' in request.auth.token) ||
         request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonAnonymousOwner(userId) {
      return isNonAnonymous() && request.auth.uid == userId;
    }

    function isGameHost(gameId) {
      return isNonAnonymous() &&
        exists(/databases/$(database)/documents/games/$(gameId)) &&
        get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid;
    }

    function isCompetitionOrganizer(competitionId) {
      return isNonAnonymous() &&
        exists(/databases/$(database)/documents/competitions/$(competitionId)) &&
        get(/databases/$(database)/documents/competitions/$(competitionId)).data.organizerId == request.auth.uid;
    }

    function isPlayerInGame(gameId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid));
    }

    // ==========================================
    // 1. Users collection: Private user profiles
    // ==========================================
    // - Users can read ONLY their own private profile.
    // - Unrelated authenticated users CANNOT read other users' profile records.
    // - Users cannot modify their own roles or administrative privileges.
    // - Immutable ownership identifiers are preserved.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student' || request.resource.data.role == 'user') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'avatarConfig', 'bio', 'themePreference', 'updatedAt']) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if isOwner(userId);
    }

    // ==========================================
    // 2. Quizzes & Question Bank: Teacher owned
    // ==========================================
    match /quizzes/{quizId} {
      allow read: if isSignedIn() && (resource.data.authorId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isNonAnonymous() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.authorId == request.auth.uid;
    }

    match /questionBank/{questionId} {
      allow read: if isNonAnonymous() && (resource.data.authorId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isNonAnonymous() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.authorId == request.auth.uid;
    }

    // ==========================================
    // 3. Games collection and subcollections
    // ==========================================
    match /games/{gameId} {
      // Disallow public unrestricted listing. Only host or enrolled players can read the game.
      allow read: if isGameHost(gameId) || isPlayerInGame(gameId);

      // Games are created server-side via POST /api/create-game with verified hostId.
      // Direct client creation is blocked to prevent spoofed host IDs.
      allow create: if false;
      allow update: if isGameHost(gameId);
      allow delete: if isGameHost(gameId);

      // Subcollection: Secrets (Host-only answer keys, never accessible to players)
      match /secrets/{secretId} {
        allow read, write: if isGameHost(gameId);
      }

      // Subcollection: Kicked players (Server-controlled scalable blacklist)
      match /kickedPlayers/{playerId} {
        allow read: if isGameHost(gameId) || (isSignedIn() && request.auth.uid == playerId);
        allow write: if false; // server-side Admin SDK only
      }

      // Subcollection: Guest emails (Host and owning player only)
      match /guestEmails/{playerId} {
        allow read: if (isSignedIn() && request.auth.uid == playerId) || isGameHost(gameId);
        allow create, update: if isSignedIn() && request.auth.uid == playerId;
        allow delete: if (isSignedIn() && request.auth.uid == playerId) || isGameHost(gameId);
      }

      // Subcollection: Players
      // - Direct client creation is blocked. Players MUST join through POST /api/join.
      // - Direct client deletion is blocked. Players CANNOT delete records to reset strikes/penalties.
      // - Direct client modification of score, strikes, status, powerUps, accommodations is blocked.
      // - Only avatar presentation fields may be updated by the player.
      match /players/{playerId} {
        allow read: if isGameHost(gameId) || isPlayerInGame(gameId);
        allow create: if false; // Server Admin SDK only via POST /api/join
        allow delete: if false; // Server Admin SDK only (preserve integrity history)
        allow update: if (
          (isSignedIn() && request.auth.uid == playerId &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarConfig', 'avatar', 'lastSeen']) &&
            (!('avatarConfig' in request.resource.data) || (request.resource.data.avatarConfig is map && request.resource.data.avatarConfig.size() <= 12))) ||
          isGameHost(gameId)
        );
      }

      // Subcollection: Answers
      // - Players CANNOT read other players' submitted answers.
      // - An individual player can read ONLY their own answers.
      // - Host can read all answers for analytics and cohort scorecards.
      // - Answers can only be created/scored server-side by Admin SDK via /api/answer.
      match /answers/{answerId} {
        allow read: if isGameHost(gameId) || (isSignedIn() && resource.data.playerId == request.auth.uid);
        allow create, update: if false; // Server Admin SDK only via POST /api/answer
        allow delete: if isGameHost(gameId);
      }

      // Subcollection: Flags (Integrity telemetry)
      match /flags/{flagId} {
        allow read: if isGameHost(gameId);
        allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
        allow update, delete: if isGameHost(gameId);
      }

      // Subcollection: Live Q&A
      match /questionsQA/{qaId} {
        allow read: if isGameHost(gameId) || isPlayerInGame(gameId);
        allow create: if isPlayerInGame(gameId) && request.resource.data.authorId == request.auth.uid;
        allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isGameHost(gameId);
        allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isGameHost(gameId);
      }
    }

    // ==========================================
    // 4. Competitions collection
    // ==========================================
    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow create: if isNonAnonymous() && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if isCompetitionOrganizer(competitionId);

      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isCompetitionOrganizer(competitionId);
      }

      match /appeals/{appealId} {
        allow read: if (isSignedIn() && resource.data.playerId == request.auth.uid) || isCompetitionOrganizer(competitionId);
        allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
        allow update, delete: if isCompetitionOrganizer(competitionId);
      }
    }

    // ==========================================
    // 5. Mail queue & Templates
    // ==========================================
    match /mail/{mailId} {
      allow read: if isNonAnonymous() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.to == request.auth.token.email
      );
      allow create: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.ownerId == request.auth.uid;
    }

    match /emailTemplates/{templateId} {
      allow read: if isNonAnonymous() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.ownerId == request.auth.uid;
    }
  }
}
