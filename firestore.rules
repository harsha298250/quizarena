rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // Anonymous players MUST NOT count for administrative/teacher/host collections
    function isNonAnonymous() {
      return isSignedIn() &&
        (!('firebase' in request.auth.token) ||
         request.auth.token.firebase.sign_in_provider != 'anonymous');
    }

    // Deletion-pending accounts are blocked from protected client operations
    // without affecting unrelated users' access to shared resources.
    function isAccountActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'deletion_pending';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isNonAnonymousOwner(userId) {
      return isNonAnonymous() && request.auth.uid == userId;
    }

    function isGameHost(gameId) {
      return isNonAnonymous() &&
        exists(/databases/$(database)/documents/games/$(gameId)) &&
        get(/databases/$(database)/documents/games/$(gameId)).data.hostId == request.auth.uid;
    }

    function isCompetitionOrganizer(competitionId) {
      return isNonAnonymous() &&
        exists(/databases/$(database)/documents/competitions/$(competitionId)) &&
        get(/databases/$(database)/documents/competitions/$(competitionId)).data.organizerId == request.auth.uid;
    }

    function isPlayerInGame(gameId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/games/$(gameId)/players/$(request.auth.uid));
    }

    // ==========================================
    // 1. Users collection: Private user profiles
    // ==========================================
    // - Users can read ONLY their own private profile.
    // - Unrelated authenticated users CANNOT read other users' profile records.
    // - Users cannot modify their own roles or administrative privileges.
    // - Immutable ownership identifiers are preserved.
    match /users/{userId} {
      allow read: if isOwner(userId) && isAccountActive();
      allow create: if isOwner(userId) && isAccountActive() &&
        (!('role' in request.resource.data) || request.resource.data.role == 'student' || request.resource.data.role == 'user') &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false) &&
        (!('status' in request.resource.data) || request.resource.data.status != 'deletion_pending');
      allow update: if isOwner(userId) && isAccountActive() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'avatarConfig', 'bio', 'themePreference', 'updatedAt']) &&
        (!('role' in request.resource.data) || request.resource.data.role == resource.data.role) &&
        (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == resource.data.isAdmin);
      allow delete: if false; // Server-authoritative staged account deletion only
    }

    // ==========================================
    // 2. Quizzes & Question Bank: Teacher owned
    // ==========================================
    match /quizzes/{quizId} {
      allow read: if isSignedIn() && isAccountActive() && (resource.data.authorId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isNonAnonymous() && isAccountActive() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && isAccountActive() && resource.data.authorId == request.auth.uid;
    }

    match /questionBank/{questionId} {
      allow read: if isNonAnonymous() && isAccountActive() && (resource.data.authorId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isNonAnonymous() && isAccountActive() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && isAccountActive() && resource.data.authorId == request.auth.uid;
    }

    // ==========================================
    // 3. Games collection and subcollections
    // ==========================================
    match /games/{gameId} {
      // Disallow public unrestricted listing. Only host or enrolled players can read the game.
      allow read: if isGameHost(gameId) || isPlayerInGame(gameId);

      // Games are created server-side via POST /api/create-game with verified hostId.
      // Direct client creation is blocked to prevent spoofed host IDs.
      allow create: if false;
      allow update: if isGameHost(gameId);
      allow delete: if isGameHost(gameId);

      // Subcollection: Secrets (Host-only answer keys, never accessible to players)
      match /secrets/{secretId} {
        allow read, write: if isGameHost(gameId);
      }

      // Subcollection: Kicked players (Server-controlled scalable blacklist)
      match /kickedPlayers/{playerId} {
        allow read: if isGameHost(gameId) || (isSignedIn() && request.auth.uid == playerId);
        allow write: if false; // server-side Admin SDK only
      }

      // Subcollection: Guest emails (Host and owning player only)
      match /guestEmails/{playerId} {
        allow read: if (isSignedIn() && request.auth.uid == playerId) || isGameHost(gameId);
        allow create, update: if isSignedIn() && request.auth.uid == playerId;
        allow delete: if (isSignedIn() && request.auth.uid == playerId) || isGameHost(gameId);
      }

      // Subcollection: Players
      // - Direct client creation is blocked. Players MUST join through POST /api/join.
      // - Direct client deletion is blocked. Players CANNOT delete records to reset strikes/penalties.
      // - Direct client modification of score, strikes, status, powerUps, accommodations is blocked.
      // - Host client direct manipulation of player score, strikes, and status is blocked (SEC-06 hardening).
      //   All legitimate host operations (kick, reinstate, approve accommodations) execute via authenticated server endpoints.
      // - Only avatar presentation fields may be updated by the player.
      match /players/{playerId} {
        allow read: if isGameHost(gameId) || isPlayerInGame(gameId);
        allow create: if false; // Server Admin SDK only via POST /api/join
        allow delete: if false; // Server Admin SDK only (preserve integrity history)
        allow update: if (
          isSignedIn() && request.auth.uid == playerId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avatarConfig', 'avatar', 'lastSeen']) &&
          (!('avatarConfig' in request.resource.data) || (request.resource.data.avatarConfig is map && request.resource.data.avatarConfig.size() <= 12))
        );
      }

      // Subcollection: Answers
      // - Players CANNOT read other players' submitted answers.
      // - An individual player can read ONLY their own answers.
      // - Host can read all answers for analytics and cohort scorecards.
      // - Answers can only be created/scored server-side by Admin SDK via /api/answer.
      // - Direct client modification or deletion of answers is strictly blocked to protect audit trails.
      match /answers/{answerId} {
        allow read: if isGameHost(gameId) || (isSignedIn() && resource.data.playerId == request.auth.uid);
        allow create, update, delete: if false; // Server Admin SDK only via POST /api/answer
      }

      // Subcollection: Flags (Integrity telemetry)
      match /flags/{flagId} {
        allow read: if isGameHost(gameId);
        allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
        allow update, delete: if isGameHost(gameId);
      }

      // Subcollection: Live Q&A
      match /questionsQA/{qaId} {
        allow read: if isGameHost(gameId) || isPlayerInGame(gameId);
        allow create: if isPlayerInGame(gameId) && request.resource.data.authorId == request.auth.uid;
        allow update: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isGameHost(gameId);
        allow delete: if (isSignedIn() && resource.data.authorId == request.auth.uid) || isGameHost(gameId);
      }
    }

    // ==========================================
    // 4. Competitions collection
    // ==========================================
    match /competitions/{competitionId} {
      allow read: if isSignedIn();
      allow create: if isNonAnonymous() && request.resource.data.organizerId == request.auth.uid;
      allow update, delete: if isCompetitionOrganizer(competitionId);

      match /rounds/{roundId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isCompetitionOrganizer(competitionId);
      }

      match /appeals/{appealId} {
        allow read: if (isSignedIn() && resource.data.playerId == request.auth.uid) || isCompetitionOrganizer(competitionId);
        allow create: if isSignedIn() && request.resource.data.playerId == request.auth.uid;
        allow update, delete: if isCompetitionOrganizer(competitionId);
      }
    }

    // ==========================================
    // 5. Mail queue & Templates
    // ==========================================
    match /mail/{mailId} {
      allow read: if isNonAnonymous() && isAccountActive() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.to == request.auth.token.email
      );
      allow write: if false; // Legacy collection: direct client writes disabled; production dispatch uses backend emailOutbox
    }

    match /emailTemplates/{templateId} {
      allow read: if isNonAnonymous() && (resource.data.ownerId == request.auth.uid || resource.data.isPublic == true);
      allow create: if isNonAnonymous() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isNonAnonymous() && resource.data.ownerId == request.auth.uid;
    }

    // ==========================================
    // 6. Tournaments & Brackets (Phase 3 Persistent & Server-Authoritative)
    // ==========================================
    function isTournamentReadable(tournamentId, tournamentData) {
      return isNonAnonymous() && isAccountActive() && (
        tournamentData.visibility != 'private' ||
        tournamentData.hostId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/tournaments/$(tournamentId)/registrations/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/tournaments/$(tournamentId)/registrations/$(request.auth.uid)).data.status == 'registered'
        )
      );
    }

    match /tournaments/{tournamentId} {
      // Public tournaments are readable by authenticated non-anonymous users;
      // private tournaments only by host or actively registered participants.
      allow read: if isTournamentReadable(tournamentId, resource.data);

      // Creation, rounds, and match progression are strictly server-authoritative
      // via POST /api/tournaments/* with verified host tokens and atomic transactions.
      allow create, delete: if false;
      allow update: if isNonAnonymous() && resource.data.hostId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description', 'bannerUrl', 'theme']);

      match /matches/{matchId} {
        allow read: if exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
          isTournamentReadable(
            tournamentId,
            get(/databases/$(database)/documents/tournaments/$(tournamentId)).data
          );
        allow write: if false; // Server-authoritative Admin SDK only
      }

      match /registrations/{registrationId} {
        allow read: if isNonAnonymous() && (
          request.auth.uid == registrationId ||
          get(/databases/$(database)/documents/tournaments/$(tournamentId)).data.hostId == request.auth.uid
        );
        allow write: if false; // Server-authoritative Admin SDK with capacity checks
      }

      match /results/{resultId} {
        allow read: if exists(/databases/$(database)/documents/tournaments/$(tournamentId)) &&
          isTournamentReadable(
            tournamentId,
            get(/databases/$(database)/documents/tournaments/$(tournamentId)).data
          );
        allow write: if false; // Server-authoritative Admin SDK only
      }
    }

    // ==========================================
    // 7. Digital Certificates (Phase 2 Persistent & Server-Authoritative)
    // ==========================================
    match /certificates/{certificateId} {
      // Only the certificate owner or issuing host may read private certificate records directly.
      // Public verification must go through GET /api/certificates/verify/:verificationId.
      allow read: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        resource.data.issuerId == request.auth.uid
      );

      // Issuance and revocation are strictly server-authoritative via Admin SDK
      // (/api/certificates/issue, /api/certificates/revoke). Direct client writes blocked.
      allow write: if false;
    }

    match /certificateVerification/{verificationId} {
      allow read, write: if false; // Server Admin SDK only
    }

    match /certificateIdempotency/{idempotencyKey} {
      allow read, write: if false; // Server Admin SDK only
    }

    // ==========================================
    // 8. Account Deletion Lifecycle (Phase 4 Server-Authoritative)
    // ==========================================
    match /accountDeletionJobs/{jobId} {
      // Only the owning non-anonymous user may read their active deletion job; clients cannot write.
      allow read: if isNonAnonymous() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /accountDeletionLocks/{uidHash} {
      allow read, write: if false; // Server Admin SDK only
    }

    match /accountDeletionEmailBlocks/{emailHash} {
      allow read, write: if false; // Server Admin SDK only
    }

    // ==========================================
    // 9. Durable Email Outbox (Phase 5 Server-Authoritative)
    // ==========================================
    match /emailOutbox/{jobId} {
      allow read, write: if false; // Server Admin SDK only
    }

    match /emailOutboxIdempotency/{keyHash} {
      allow read, write: if false; // Server Admin SDK only
    }

    match /emailWebhookEvents/{eventKey} {
      allow read, write: if false; // Server Admin SDK only
    }

    match /emailOutboxMetrics/{docId} {
      allow read, write: if false; // Server Admin SDK only
    }
  }
}
