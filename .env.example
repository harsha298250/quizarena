# =============================================================================
# QUIZARENA — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env for local development.
# In production (Vercel/Render), configure these values in your dashboard secrets.
# NEVER commit real credentials, service account keys, or API tokens to git.

# -----------------------------------------------------------------------------
# 1. RUNTIME & SERVER
# -----------------------------------------------------------------------------
NODE_ENV="development"
PORT=3001

# -----------------------------------------------------------------------------
# 2. CORS ALLOWLIST (Production)
# Comma-separated list of allowed origins. Supports wildcard domains (e.g. *.vercel.app).
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173,https://*.vercel.app,https://your-custom-domain.com"

# -----------------------------------------------------------------------------
# 3. FRONTEND API ROUTING
# Set if frontend is hosted separately from backend (e.g. Vercel -> Render).
# Leave empty for same-origin or reverse-proxy deployments.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=""

# -----------------------------------------------------------------------------
# 4. FIREBASE ADMIN SDK (Backend Security & Authoritative Operations)
# Provide either an absolute/relative file path OR the inline raw JSON string.
# -----------------------------------------------------------------------------
# FIREBASE_SERVICE_ACCOUNT_KEY="./serviceAccountKey.json"
# FIREBASE_SERVICE_ACCOUNT_KEY="{\"type\":\"service_account\",\"project_id\":\"...\"}"
# GOOGLE_APPLICATION_CREDENTIALS=""

# -----------------------------------------------------------------------------
# 5. FIREBASE CLIENT CONFIGURATION (Vite Frontend)
# (Optional if firebase-applet-config.json is present)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""

# -----------------------------------------------------------------------------
# 6. GOOGLE GEMINI AI CONFIGURATION
# -----------------------------------------------------------------------------
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"
VITE_GEMINI_MODEL="gemini-3.8-flash"
VITE_AI_ENDPOINT="/api/generate-quiz"

# -----------------------------------------------------------------------------
# 7. EMAIL DISPATCH & NOTIFICATIONS (Phase 7 Multi-Provider Hardening)
# Configure EMAIL_PROVIDER ('resend', 'brevo', 'smtp', or 'none').
# If EMAIL_PROVIDER is omitted, provider is auto-detected from credentials.
# -----------------------------------------------------------------------------
EMAIL_PROVIDER="resend"

# Global / Resend Sender Address:
# For testing with Resend without a custom domain, you MUST use onboarding@resend.dev:
EMAIL_FROM="QuizArena <onboarding@resend.dev>"
# RESEND_FROM="QuizArena <onboarding@resend.dev>"

# Provider A: Resend API (HTTPS Port 443 — Recommended for Cloud / Render / Vercel)
# Free accounts can send from onboarding@resend.dev to their registered account email
# or to delivered@resend.dev. To send to any student, verify domain at resend.com/domains.
RESEND_API_KEY=""

# Provider B: Brevo API / SMTP (HTTPS Port 443)
BREVO_API_KEY=""
# BREVO_SENDER="QuizArena <notifications@your-domain.com>"
# BREVO_USER=""
# BREVO_KEY=""

# Provider C: Standard SMTP (Only active when EMAIL_PROVIDER="smtp" or when SMTP credentials exist without Resend/Brevo)
# Note: Render Free tier blocks outbound SMTP ports 25, 465 & 587. Use Resend on Render Free tier.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-char-app-password"
SMTP_FROM="QuizArena <noreply@quizarena.app>"

# -----------------------------------------------------------------------------
# 8. OUTBOX WORKER & CRON SECURITY
# Bearer token used by external cron schedulers (Render Cron, GitHub Actions, or Vercel Cron)
# to trigger batch email outbox dispatch (/api/outbox/process).
# -----------------------------------------------------------------------------
OUTBOX_WORKER_SECRET=""
OUTBOX_WEBHOOK_SECRET=""
